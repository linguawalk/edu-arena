  "context": {
    "explanation_en": "« -을/ㄹ수록 » means the more ~, the more ~. For example, « 연습할수록 실력이 늘어요 » (The more you practice, the more your skill improves).",
    "explanation_ko": "'-을/ㄹ수록'은 '~할수록 더 ~하다'를 의미합니다. 예: '연습할수록 실력이 늘어요'.",
    "key_expressions": [
      {
        "en": "The more you practice, the more your skill improves.",
        "ko": "연습할수록 실력이 늘어요."
      },
      {
        "en": "The older I get, the busier I become.",
        "ko": "나이가 들수록 바빠져요."
      },
      {
        "en": "The more you think about it, the more complicated it gets.",
        "ko": "생각할수록 복잡해져요."
      }
    ]
  },

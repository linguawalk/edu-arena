    "key_expressions": [
      {
        "en": "Hello. My name is Kim.",
        "ko": "안녕하세요. 저는 김이에요."
      },
      {
        "en": "Nice to meet you.",
        "ko": "만나서 반가워요."
      },
      {
        "en": "I am a student.",
        "ko": "저는 학생이에요."
      }
    ]
  },

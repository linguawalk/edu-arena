  "context": {
    "explanation_en": "To narrate what happened yesterday, use « 어제 ~았/었어요 » (Yesterday I ~). Combine several past-tense actions for a fuller story.",
    "explanation_ko": "어제 있었던 일을 말할 때는 '어제 ~았/었어요'를 씁니다. 여러 과거시제 문장을 결합해서 이야기를 만들 수 있습니다.",
    "key_expressions": [
      {
        "en": "Yesterday I met a friend.",
        "ko": "어제 친구를 만났어요."
      },
      {
        "en": "Yesterday I was very busy.",
        "ko": "어제 정말 바빴어요."
      },
      {
        "en": "Yesterday I stayed home all day.",
        "ko": "어제 하루 종일 집에 있었어요."
      }
    ]
  },

{
  "meta": {
    "id": "en_c1_u01",
    "domain": "language",
    "lang": "en",
    "level": "c1",
    "unit": 1,
    "title": "Synonyms for \"Say\"",
    "title_ko": "\"Say\"의 유의어",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "Precise reporting verbs replace plain 'say' with more specific nuance: 'state' (formal, factual), 'claim' (asserted but not proven), 'assert' (confident, firm), 'remark' (casual observation). Choosing the right one signals your attitude toward what was said.",
    "explanation_ko": "정확한 보고 동사는 평범한 'say'를 더 구체적인 뉘앙스로 대체합니다: 'state'(격식적, 사실적), 'claim'(주장하지만 증명 안 됨), 'assert'(자신 있고 단호함), 'remark'(캐주얼한 발언). 어느 것을 고르느냐가 발언에 대한 당신의 태도를 드러냅니다.",
    "key_expressions": [
      {
        "en": "The CEO stated that profits had risen.",
        "ko": "CEO는 이익이 증가했다고 밝혔어요."
      },
      {
        "en": "He claims to have invented the idea.",
        "ko": "그는 그 아이디어를 자신이 만들었다고 주장해요."
      },
      {
        "en": "She remarked that the coffee was excellent.",
        "ko": "그녀는 커피가 훌륭하다고 (지나가듯) 말했어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u01_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write two sentences reporting what someone said, using 'claim' for an unproven statement and 'state' for a formal, factual one.",
        "ko": "누군가 한 말을 전하는 문장 두 개를 써 보세요: 입증되지 않은 발언은 'claim'으로, 격식적·사실적 발언은 'state'로 쓰세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "claim",
          "label_ko": "claim",
          "min_occurrences": 1
        },
        {
          "type": "vocabulary",
          "id": "state",
          "label_ko": "state",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'claim(s/ed)'을 사용했는가",
          "type": "pattern_regex",
          "target": "\\bclaim(s|ed)?\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'state(s/d)'를 사용했는가",
          "type": "pattern_regex",
          "target": "\\bstate[sd]?\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "문장이 2개 이상인가",
          "type": "pattern_regex",
          "target": "[.!]",
          "min_matches": 2,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },

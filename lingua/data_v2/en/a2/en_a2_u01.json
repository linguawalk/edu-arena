    "key_expressions": [
      {
        "en": "Have you ever been to ~?",
        "ko": "~에 가본 적 있어요?"
      },
      {
        "en": "Yes, I have. / No, I haven't.",
        "ko": "네, 있어요. / 아니요, 없어요."
      },
      {
        "en": "I went there two years ago.",
        "ko": "저는 2년 전에 거기 갔었어요."
      }
    ]
  },

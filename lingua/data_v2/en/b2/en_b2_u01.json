    "lang": "en",
    "level": "b2",
    "unit": 1,
    "title": "Inversion for Emphasis",
    "title_ko": "강조를 위한 도치",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Starting a sentence with a negative or limiting adverb (never, rarely, not only, no sooner) triggers inversion — the auxiliary verb moves before the subject, like in a question: 'Never have I seen such chaos.' 'Not only did she win, but she also broke the record.'",
    "explanation_ko": "부정·제한 부사(never, rarely, not only, no sooner)로 문장을 시작하면 도치가 일어납니다 — 조동사가 의문문처럼 주어 앞으로 옵니다: 'Never have I seen such chaos.' 'Not only did she win, but she also broke the record.'",
    "key_expressions": [
      {
        "en": "Never have I felt so proud.",
        "ko": "이렇게 자랑스러웠던 적이 없어요."
      },
      {
        "en": "Not only was it expensive, but it also broke quickly.",
        "ko": "비쌌을 뿐 아니라 금방 고장 났어요."
      },
      {
        "en": "Rarely do we get a chance like this.",
        "ko": "이런 기회는 좀처럼 없어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u01_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about an intense experience using inversion with 'Never have I' or 'Rarely do I'.",
        "ko": "강렬했던 경험을 'Never have I' 또는 'Rarely do I' 도치 구문을 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "inversion",
          "label_ko": "도치",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "도치 구조(Never have I / Rarely do I 등)를 사용했는가",
          "type": "pattern_regex",
          "target": "(never|rarely|seldom)\\s+(have|has|do|does|did)\\s+i",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",

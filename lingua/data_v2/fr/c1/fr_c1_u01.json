    "key_expressions": [
      {
        "en": "Le président a déclaré la victoire.",
        "ko": "대통령이 승리를 선언했어요."
      },
      {
        "en": "Il affirme qu'il est innocent.",
        "ko": "그는 자신이 결백하다고 확언해요."
      },

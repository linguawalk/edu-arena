    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "「誘う」は一緒に何かをするよう声をかけること、「促す」は行動を起こすよう働きかけること、「唆す」は悪いことをするよう仕向けることを表します。",
    "explanation_ko": "'誘う'는 함께 무언가를 하자고 부르는 것, '促す'는 행동을 일으키도록 촉구하는 것, '唆す'는 나쁜 짓을 하도록 부추기는 것을 나타냅니다.",
    "key_expressions": [
      {
        "en": "えいがにさそいました。",
        "ko": "영화 보러 가자고 청했어요."
      },
      {
        "en": "こうどうをうながしました。",
        "ko": "행동을 촉구했어요."
      },
      {
        "en": "はんざいをそそのかしました。",
        "ko": "범죄를 부추겼어요."
      }
    ]
  },

  "context": {
    "explanation_en": "The present perfect subjunctive expresses doubt or emotion about a completed action: « Espero que hayas terminado ».",
    "explanation_ko": "접속법 현재완료는 완료된 행동에 대한 의심이나 감정을 나타냅니다: 'Espero que hayas terminado'(끝냈기를 바라요).",
    "key_expressions": [
      {
        "en": "Espero que hayas terminado el trabajo.",
        "ko": "일을 끝냈기를 바라요."
      },
      {
        "en": "No creo que haya llegado todavía.",
        "ko": "아직 도착했다고 생각하지 않아요."
      },
      {
        "en": "Me alegra que hayas venido.",
        "ko": "와줘서 기뻐요."
      }
    ]
  },

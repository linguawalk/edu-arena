    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "« Explicar » explains something clearly, « afirmar » asserts a claim confidently, « expresar » expresses an opinion, « subrayar » emphasizes a point.",
    "explanation_ko": "'explicar'(설명하다)는 무언가를 명확하게 설명하고, 'afirmar'(단언하다)는 자신 있게 주장을 내세우며, 'expresar'(표현하다)는 의견을 표현하고, 'subrayar'(강조하다)는 요점을 강조합니다.",
    "key_expressions": [
      {
        "en": "Explica el problema en detalle.",
        "ko": "그는 문제를 자세히 설명해요."
      },
      {
        "en": "Afirma que es verdad.",
        "ko": "그녀는 그게 사실이라고 단언해요."
      },
      {
        "en": "Subraya la importancia de este punto.",
        "ko": "그는 이 점의 중요성을 강조해요."
      }
    ]
  },

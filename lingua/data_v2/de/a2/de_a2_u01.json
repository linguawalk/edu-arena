  "context": {
    "explanation_en": "To say you have already done something, we use « Ich habe schon... ». To say you have never done something, we use « Ich habe noch nie... ».",
    "explanation_ko": "이미 해본 것을 말할 때는 'Ich habe schon...'(저는 이미 ~해봤어요), 아직 한 번도 안 해본 것을 말할 때는 'Ich habe noch nie...'(저는 아직 한 번도 ~해본 적 없어요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich habe schon Deutschland besucht.",
        "ko": "저는 이미 독일에 가봤어요."
      },
      {
        "en": "Ich habe noch nie Sushi gegessen.",
        "ko": "저는 아직 한 번도 초밥을 먹어본 적 없어요."
      },
      {
        "en": "Haben Sie schon einmal geangelt?",
        "ko": "낚시해본 적 있어요?"
      }
    ]
  },

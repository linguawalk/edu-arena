    "key_expressions": [
      {
        "en": "Ich würde gerne nach Berlin reisen.",
        "ko": "저는 베를린으로 여행 가고 싶어요."
      },
      {
        "en": "Könnten Sie mir bitte helfen?",
        "ko": "저 좀 도와주실 수 있어요?"
      },
      {
        "en": "Das würde ich nicht machen.",
        "ko": "저라면 그렇게 안 할 거예요."
      }
    ]
